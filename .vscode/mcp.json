{
  "servers": {
    "metabokg": {
      "type": "stdio",
      "command": "poetry",
      "args": [
        "run",
        "metabokg-mcp",
        "--db",
        "data/hsa_pathways/.metabokg/hsa.sqlite",
        "--vectors",
        "data/hsa_pathways/.metabokg/vectors.sqlite"
      ],
      "env": {
        "POETRY_VIRTUALENVS_IN_PROJECT": "false"
      }
    },
    "pycodekg": {
      "type": "stdio",
      "command": "poetry",
      "args": [
        "run",
        "pycodekg-mcp",
        "--repo",
        "."
      ],
      "env": {
        "POETRY_VIRTUALENVS_IN_PROJECT": "false"
      }
    }
  }
}
